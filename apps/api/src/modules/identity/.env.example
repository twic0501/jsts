# Server-only required names. Set actual values in the API environment, not VITE_*.
# This file is documentation, not automatically loaded by Identity.
# MONGODB_URI must target a replica set/sharded Mongo deployment with transaction support.
MONGODB_URI=
IDENTITY_MONGODB_DB=
IDENTITY_SECRET=
IDENTITY_ALLOWED_ORIGINS=
IDENTITY_SESSION_TTL_SECONDS=
IDENTITY_SESSION_SAME_SITE=
IDENTITY_AUTH_WINDOW_SECONDS=
IDENTITY_AUTH_MAX_ATTEMPTS=
# MAX_ATTEMPTS is now the shared global budget per operation/window.
# Optional smaller per-source budget, only used with an approved server-side requestSource resolver:
# IDENTITY_AUTH_SOURCE_MAX_ATTEMPTS=
IDENTITY_AUTH_MAX_CONCURRENT=
IDENTITY_REGISTRATION_RECEIPT_TTL_SECONDS=
