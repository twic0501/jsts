  "schemas": {
    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "displayName",
        "email",
        "role",
        "revision",
        "updatedAt"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 200
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "path",
                  "reason"
                ]
              },
              "maxItems": 30
            }
          },
          "required": [
            "code",
            "message"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "error",
        "requestId"
      ],
      "examples": [
        {
          "error": {
            "code": "REVISION_MISMATCH",
            "message": "Ghi chú đã có phiên bản mới. Bản nháp cục bộ được giữ để đối chiếu."
          },
          "requestId": "4e4ea11e-c826-48cc-9c37-6937559b1068"
        }
      ]
    },
    "RegisterInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "email",
        "password",
        "displayName"
      ]
    },
    "ProfilePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [],
      "minProperties": 1
