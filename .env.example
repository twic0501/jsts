# Optional MongoDB. Without this variable, the API explicitly uses the local JSON corpus.
# MONGODB_URI=mongodb://127.0.0.1:27017/paper_galaxy
API_PORT=3001
WEB_PORT=5173

# Optional: key stays on the backend. Never prefix secrets with VITE_.
# OPENALEX_API_KEY=
# Production static/proxy server (Next API remains loopback).
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# API_ORIGIN=http://127.0.0.1:3001
# PUBLIC_ORIGIN=https://your-domain.example
# For direct HTTPS443, provide both valid certificate files:
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem

